# Fetch service: runs the fetch script under a virtual X display (xvfb-run) so
# Playwright's headed Chromium works on a server with no desktop. The script
# calls Mastercard's conversion-rates API for the 1st of the current month and
# caches the result in local/state.json. Its self-dedup (src/shared/state.ts)
# makes every firing after the first successful fetch of the month a no-op,
# and it exits silently on the 1st. See ADR-0007 for the daily trigger.
#
# node and pnpm come from nvm, which only puts them on PATH when nvm.sh is
# sourced, so the command runs through bash and sources it first. That also
# tracks nvm's default alias across node upgrades with no edit here.
#
# Triggered by rental-fetch.timer. Output goes to journald:
#   journalctl --user -u rental-fetch.service
#
# Installed by symlink from this repo (scripts/install-systemd.sh), so
# %h expands to the home directory and no rendering step is needed.

[Unit]
Description=Rental: cache the Mastercard FX Rate for the 1st of the month

[Service]
Type=oneshot
WorkingDirectory=%h/repo/rental-mastercard-calculator
ExecStart=/bin/bash -c 'source %h/.nvm/nvm.sh && exec xvfb-run -a pnpm --silent start'
